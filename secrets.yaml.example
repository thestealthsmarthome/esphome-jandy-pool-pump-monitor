# Copy to secrets.yaml (same folder as your ESPHome config) and fill in.
# The ESPHome Device Builder add-on keeps its own secrets.yaml you can edit in the UI.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# ESPHome auto-generates an API encryption key when you create the device — paste it here.
pool_pump_api_key: "GENERATED_BASE64_KEY"

# Any password for the device's fallback hotspot.
pool_pump_ap_password: "choose-a-fallback-password"
